<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!--
  Weekdays 07:30: plaud-daily-ingest -> slack-daily-digest -> morning-brief (automation/daily.sh).
  Placeholders __HOME__, __REPO__, __BRAIN_DIR__ are filled in by install.sh when run with the with-launchd flag.
  Manual install:
    sed -e "s|__HOME__|$HOME|g" -e "s|__REPO__|$PWD|g" -e "s|__BRAIN_DIR__|$HOME/brain|g" \
      automation/launchd/com.claude-lead-os.morning.plist > ~/Library/LaunchAgents/com.claude-lead-os.morning.plist
    launchctl bootstrap gui/$(id -u) ~/Library/LaunchAgents/com.claude-lead-os.morning.plist
  Run now:   launchctl kickstart gui/$(id -u)/com.claude-lead-os.morning
  Remove:    launchctl bootout gui/$(id -u)/com.claude-lead-os.morning
  If the Mac is asleep at the scheduled time, launchd runs the job once on wake.
-->
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>com.claude-lead-os.morning</string>

  <key>ProgramArguments</key>
  <array>
    <string>/bin/bash</string>
    <string>__REPO__/automation/daily.sh</string>
  </array>

  <key>EnvironmentVariables</key>
  <dict>
    <key>HOME</key>
    <string>__HOME__</string>
    <key>BRAIN_DIR</key>
    <string>__BRAIN_DIR__</string>
    <key>PATH</key>
    <string>__HOME__/.local/bin:/opt/homebrew/bin:/usr/local/bin:/usr/bin:/bin:/usr/sbin:/sbin</string>
  </dict>

  <key>WorkingDirectory</key>
  <string>__BRAIN_DIR__</string>

  <key>StartCalendarInterval</key>
  <array>
    <dict>
      <key>Weekday</key><integer>1</integer>
      <key>Hour</key><integer>7</integer>
      <key>Minute</key><integer>30</integer>
    </dict>
    <dict>
      <key>Weekday</key><integer>2</integer>
      <key>Hour</key><integer>7</integer>
      <key>Minute</key><integer>30</integer>
    </dict>
    <dict>
      <key>Weekday</key><integer>3</integer>
      <key>Hour</key><integer>7</integer>
      <key>Minute</key><integer>30</integer>
    </dict>
    <dict>
      <key>Weekday</key><integer>4</integer>
      <key>Hour</key><integer>7</integer>
      <key>Minute</key><integer>30</integer>
    </dict>
    <dict>
      <key>Weekday</key><integer>5</integer>
      <key>Hour</key><integer>7</integer>
      <key>Minute</key><integer>30</integer>
    </dict>
  </array>

  <key>RunAtLoad</key>
  <false/>

  <key>StandardOutPath</key>
  <string>__BRAIN_DIR__/.logs/launchd-morning.out.log</string>
  <key>StandardErrorPath</key>
  <string>__BRAIN_DIR__/.logs/launchd-morning.err.log</string>
</dict>
</plist>
